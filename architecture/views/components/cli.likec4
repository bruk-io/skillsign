views {

  view cliComponents of skillsign.cli {
    title 'Components / CLI Internals'
    description 'Internal structure of the CLI showing signing, verification, and policy components'

    include *
    include skillsign.skillFiles
    include skillsign.tufCache
    include github
    include fulcio
    include rekor
    include tuf

    autoLayout TopBottom
  }

}
