views {

  dynamic view signingFlow {
    title 'Flows / Skill Author / Signing'
    description 'How a skill author signs a SKILL.md file using the SkillSign CLI (Section 7.2)'
    variant sequence

    skillAuthor -> skillsign.cli.signingEngine 'Runs: skillsign sign ./SKILL.md'

    skillsign.cli.signingEngine -> skillsign.cli.manifestReader {
      title 'Reads and validates manifest'
      notes '''
        1. Reads skillsign.yaml for skill_id and skill_version
        2. Validates skill_id format (3 segments, ASCII only, max 255 chars)
        3. Validates skill_version (non-empty, printable ASCII, max 255 chars)
      '''
    }

    skillsign.cli.manifestReader -> skillsign.skillFiles 'Reads skillsign.yaml manifest'

    skillsign.cli.signingEngine -> skillsign.skillFiles {
      title 'Checks for existing sidecar (step 3)'
      notes '''
        signing.py checks sidecar_path.exists() directly on the filesystem.
        If a .skillsign sidecar already exists, fail with exit code 10 unless --force.
        Prevents accidental re-signing with a different key.
      '''
    }

    skillsign.cli.signingEngine -> skillsign.cli.canonicalProcessor {
      title 'Requests canonical form and digest (steps 4-5)'
      notes '''
        Canonical form: strip BOM, normalize line endings,
        strip trailing whitespace per line, single trailing newline.
        Digest over: "skillsign:v1" + \0 + canonical + \0 + skill_id + \0 + skill_version
      '''
    }

    skillsign.cli.canonicalProcessor -> skillsign.skillFiles 'Reads SKILL.md file'

    skillsign.cli.signingEngine -> skillsign.cli.authHandler 'Requests OIDC authentication (step 6)'
    skillsign.cli.authHandler -> github {
      title 'OIDC authentication with GitHub'
      notes '''
        Two modes:
        - Interactive: opens browser for GitHub OIDC login (developer workstation)
        - CI: uses ambient OIDC token from GitHub Actions runner (no browser)
        In CI, the certificate SAN encodes the full workflow URL
        (e.g., https://github.com/{org}/{repo}/.github/workflows/{workflow}.yml@refs/heads/main)
        rather than a personal GitHub username, enabling signer_org policy matching.
      '''
    }

    skillsign.cli.signingEngine -> fulcio {
      title 'Submits OIDC token and ephemeral public key via Sigstore SDK (steps 7-8)'
      notes '''
        signing.py calls SigningContext.from_trust_config() and ctx.signer(identity_token).
        The Sigstore SDK internally: generates ephemeral ECDSA P-256 keypair,
        submits OIDC token + public key to Fulcio, receives short-lived X.509 certificate
        (~10 min validity) binding the public key to the verified GitHub identity.
      '''
    }

    skillsign.cli.signingEngine -> skillsign.cli.signingEngine {
      title 'Signs digest with ephemeral ECDSA P-256 key (step 8, inside SDK)'
      notes '''
        The Sigstore SDK signs the 32-byte SHA-256 digest via signer.sign_artifact(Hashed).
        The ephemeral private key is created and discarded within the SDK context manager.
      '''
    }

    skillsign.cli.signingEngine -> rekor {
      title 'Submits signature, certificate, and digest as hashedrekord/v0.0.1 entry via Sigstore SDK (step 9)'
      notes '''
        The Sigstore SDK submits to Rekor internally during sign_artifact().
        Rekor returns: log entry UUID, integrated_time, and Signed Entry Timestamp (SET).
        signing.py extracts these from bundle.log_entry._inner after sign_artifact() returns.
        Sidecar MUST NOT be written until Rekor confirms the log entry.
      '''
    }

    skillsign.cli.signingEngine -> skillsign.cli.signingEngine {
      title 'Assembles sidecar dict from Sigstore Bundle fields (step 10)'
      notes '''
        signing.py calls _assemble_sidecar() which extracts: signature (DER Base64),
        certificate (PEM), signer (SAN URI from cert), digest (sha256:hex),
        rekor_log_id (hex of key_id), rekor_timestamp (ISO 8601 UTC),
        rekor_set (already-base64 SET from inclusion_promise).
        Returns dict — does NOT write file; sidecar writing is done by CLI.
      '''
    }

    skillsign.cli.sidecarManager -> skillsign.skillFiles 'Writes SKILL.md.skillsign sidecar atomically via temp file rename (step 11)'
  }

}
