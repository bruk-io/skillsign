views {

  dynamic view verificationFlow {
    title 'Flows / Skill Consumer / Verification'
    description 'How a skill consumer verifies a SKILL.md signature using the SkillSign CLI (Section 8.2)'
    variant sequence

    skillConsumer -> skillsign.cli.verificationEngine 'Runs: skillsign verify ./SKILL.md'

    skillsign.cli.verificationEngine -> skillsign.cli.sidecarManager {
      title 'Reads and parses sidecar (steps 1-2)'
      notes '''
        Exits with UNSIGNED (code 2) if no sidecar is found.
        Fails with MALFORMED_SIDECAR (code 1) if YAML parsing fails,
        required fields are missing, or version is not 1.
      '''
    }

    skillsign.cli.sidecarManager -> skillsign.skillFiles 'Reads .skillsign sidecar with strict YAML 1.2 parsing'

    skillsign.cli.verificationEngine -> skillsign.cli.canonicalProcessor {
      title 'Recomputes canonical form and digest (steps 3-5)'
      notes '''
        Passes skill_id and skill_version from sidecar to recompute
        the signed input digest using the same algorithm as signing.
        If recomputed digest does not match sidecar digest field,
        fails with TAMPERED (exit code 1).
      '''
    }

    skillsign.cli.canonicalProcessor -> skillsign.skillFiles 'Reads SKILL.md file'

    skillsign.cli.verificationEngine -> skillsign.cli.verificationEngine {
      title 'Cryptographic verification (steps 6, 8 — implemented)'
      notes '''
        1. Verify ECDSA P-256 signature over digest using certificate public key (step 6)
        2. Verify certificate SAN matches signer field (exact, case-sensitive) (step 8)
        3. Verify EKU extension contains id-kp-codeSigning (OID 1.3.6.1.5.5.7.3.3) (step 8)
        Note: cert chain validation (step 7) and SET verification (step 9) are
        Phase 2 items — currently stubbed with TODO comments in verify.py.
      '''
    }

    // Phase 2: TUF-based cert chain validation (step 7) and SET verification (step 9)
    skillsign.cli.verificationEngine -> skillsign.cli.tufClient 'Requests trusted Fulcio root certificates and Rekor public key (step 7) [Phase 2]'

    parallel {
      skillsign.cli.tufClient -> tuf 'Fetches current TUF root metadata [Phase 2]'
      skillsign.cli.tufClient -> skillsign.tufCache 'Reads/writes cached TUF metadata [Phase 2]'
    }

    skillsign.cli.verificationEngine -> skillsign.cli.verificationEngine {
      title 'SET verification and temporal binding (step 9) [Phase 2]'
      notes '''
        1. Verify SET cryptographic signature against Rekor public key (via TUF)
        2. Confirm SET timestamp falls within certificate notBefore/notAfter window
        This proves the signature was created while the certificate was valid,
        without requiring live Rekor access (unless --strict).
        Currently a TODO in verify.py — planned for Phase 2 hardening.
      '''
    }

    skillsign.cli.verificationEngine -> skillsign.cli.verificationEngine {
      title 'SKILL_ID_MISMATCH owner-path check (step 11)'
      notes '''
        Compares skill_id owner path against signer owner path:
        1. From skill_id, extract {host}/{owner}
        2. From signer URL, extract {host}/{first-path-segment}
           (percent-decode path first to prevent %2F bypass)
        3. Compare case-insensitively after lowercasing both
        Hard failure (exit 1) by default.
        Downgrade via --allow-id-mismatch or policy require_signer_id_match: false.
      '''
    }

    skillsign.cli.verificationEngine -> skillConsumer {
      title 'Returns VERIFIED (exit 0) or failure with specific exit code'
      notes '''
        Race condition mitigation (TOCTOU): callers may use --emit-canonical
        to receive verified canonical bytes on stdout, piping directly to a
        loader without a filesystem re-read (Section 9.1, Section 11).
      '''
    }
  }

}
