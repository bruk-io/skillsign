#!/usr/bin/env python3
"""
PostToolUse hook for TaskUpdate: after task completion, suggest which
reviewers to dispatch based on changed files.

Runs git diff main...HEAD, maps changed files to the review dispatch table
from sprint-review, and prints reviewer suggestions. Silently exits if
not in a worktree branch or no files changed.
"""

import json
import os
import subprocess
import sys

# Maps file path patterns to required reviewers
DISPATCH_TABLE: dict[str, list[str]] = {
    "canonical": ["input-surface-reviewer (Opus)"],
    "sign": ["crypto-reviewer (Opus)"],
    "crypto": ["crypto-reviewer (Opus)"],
    "verify": ["crypto-reviewer (Opus)", "identity-reviewer (Opus)"],
    "policy": ["policy-reviewer (Opus)"],
    "oidc": ["identity-reviewer (Opus)"],
    "identity": ["identity-reviewer (Opus)"],
    "architecture/": ["c4-reviewer (Sonnet)"],
    "spec.md": ["consistency-checker (Opus)"],
}


def main() -> None:
    tool_input = os.environ.get("CLAUDE_TOOL_INPUT", "{}")
    try:
        params = json.loads(tool_input)
    except json.JSONDecodeError:
        return

    if params.get("status") != "completed":
        return

    # Get changed files relative to main
    try:
        result = subprocess.run(
            ["git", "diff", "--name-only", "main...HEAD"],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if result.returncode != 0:
            return
        changed = [f for f in result.stdout.strip().split("\n") if f]
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return

    if not changed:
        return

    # Always require code review
    reviewers: set[str] = {"code-reviewer (Sonnet)"}

    for filepath in changed:
        for pattern, reviewer_list in DISPATCH_TABLE.items():
            if pattern in filepath:
                reviewers.update(reviewer_list)

    print("Review dispatch — suggested reviewers based on changed files:")
    for reviewer in sorted(reviewers):
        print(f"  - {reviewer}")
    print(f"\nChanged files: {len(changed)}")
    print("See sprint-review skill for full dispatch rules and agent types.")


if __name__ == "__main__":
    main()
