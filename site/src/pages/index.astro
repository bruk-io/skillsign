---
import Base from '../layouts/Base.astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<Base title="SkillSign — Trust for Claude Code Skills">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <bh-badge variant="primary" size="sm">v0.1 — Sigstore Keyless Signing</bh-badge>
      <h1 class="heading-xl">
        Cryptographic trust for<br />
        <span class="text-primary">Claude Code skills</span>
      </h1>
      <p class="hero-subtitle text-muted">
        Sign SKILL.md files with your GitHub identity. Verify authorship and integrity
        before execution. No long-lived keys — powered by Sigstore.
      </p>
      <bh-cluster gap="md">
        <bh-button variant="primary" size="lg" onclick={`window.location.href='${base}getting-started'`}>
          Get Started
        </bh-button>
        <bh-button variant="secondary" size="lg" onclick="window.location.href='https://github.com/bruk-io/skillsign'">
          View on GitHub
        </bh-button>
      </bh-cluster>
      <div class="hero-install">
        <div class="code-block">pip install skillsign</div>
      </div>
    </div>
  </section>

  <!-- Threat Model -->
  <section class="section section-alt">
    <div class="section-inner">
      <h2 class="heading-lg text-center">What could go wrong without signing?</h2>
      <p class="text-center text-muted" style="margin-top: var(--bh-spacing-2); margin-bottom: var(--bh-spacing-10);">
        SKILL.md files aren't documentation — they're executable instructions with filesystem,
        shell, and network access.
      </p>
      <bh-grid gap="md" min="280px">
        <bh-card variant="outlined" padding="lg">
          <div slot="header">
            <span class="threat-icon">🔓</span>
            <span class="heading-sm">Tampered Skills</span>
          </div>
          <bh-stack gap="sm">
            <p>A skill modified after publication to inject malicious instructions.</p>
            <p class="text-muted"><strong>SkillSign detects this.</strong> Verification recomputes the file digest and compares it to the signed hash — any byte change fails with TAMPERED.</p>
          </bh-stack>
        </bh-card>

        <bh-card variant="outlined" padding="lg">
          <div slot="header">
            <span class="threat-icon">🎭</span>
            <span class="heading-sm">Impersonation</span>
          </div>
          <bh-stack gap="sm">
            <p>A skill claiming to be from a trusted author without verifiable proof. Anyone can name a package anything.</p>
            <p class="text-muted"><strong>SkillSign detects this.</strong> The signer's GitHub identity is bound to a Fulcio certificate via OIDC. Verification checks the certificate SAN — forgery fails with IDENTITY_MISMATCH.</p>
          </bh-stack>
        </bh-card>

        <bh-card variant="outlined" padding="lg">
          <div slot="header">
            <span class="threat-icon">📦</span>
            <span class="heading-sm">Supply Chain Risk</span>
          </div>
          <bh-stack gap="sm">
            <p>A compromised dependency in a skill's ecosystem that introduces malicious code.</p>
            <p class="text-muted"><strong>SkillSign partially addresses this.</strong> It signs the SKILL.md file itself — tampering with the skill is detected. However, it does not verify transitive dependencies or the broader package tree.</p>
          </bh-stack>
        </bh-card>

        <bh-card variant="outlined" padding="lg">
          <div slot="header">
            <span class="threat-icon">💉</span>
            <span class="heading-sm">Runtime Mutation</span>
          </div>
          <bh-stack gap="sm">
            <p>A skill that fetches remote content at execution time to change its own behavior.</p>
            <p class="text-muted"><strong>SkillSign does not prevent this.</strong> Signatures verify file content at signing time. If a skill dynamically loads instructions at runtime, that behavior is outside the signed scope.</p>
          </bh-stack>
        </bh-card>
      </bh-grid>
    </div>
  </section>

  <!-- How It Works Overview -->
  <section class="section">
    <div class="section-inner">
      <h2 class="heading-lg text-center">How it works</h2>
      <p class="text-center text-muted" style="margin-top: var(--bh-spacing-2); margin-bottom: var(--bh-spacing-12);">
        Three steps. No key management. Fully transparent.
      </p>
      <div class="steps-grid">
        <div class="step">
          <div class="step-number">1</div>
          <h3 class="heading-sm">Sign</h3>
          <p class="text-muted">
            Authenticate with GitHub via OIDC. Sigstore issues a short-lived certificate
            binding your identity to an ephemeral key. Sign your SKILL.md — the key is discarded.
          </p>
        </div>
        <div class="step-arrow">→</div>
        <div class="step">
          <div class="step-number">2</div>
          <h3 class="heading-sm">Log</h3>
          <p class="text-muted">
            The signature and certificate are recorded in Rekor, Sigstore's append-only
            transparency log. Anyone can audit the signing history.
          </p>
        </div>
        <div class="step-arrow">→</div>
        <div class="step">
          <div class="step-number">3</div>
          <h3 class="heading-sm">Verify</h3>
          <p class="text-muted">
            Consumers verify the signature, certificate chain, and identity before execution.
            Tampered files, expired certs, and identity mismatches are caught automatically.
          </p>
        </div>
      </div>
      <div class="text-center" style="margin-top: var(--bh-spacing-8);">
        <bh-button variant="secondary" onclick={`window.location.href='${base}how-it-works'`}>
          See the full flow →
        </bh-button>
      </div>
    </div>
  </section>

  <!-- Personas -->
  <section class="section">
    <div class="section-inner">
      <h2 class="heading-lg text-center">Who is it for?</h2>
      <p class="text-center text-muted" style="margin-top: var(--bh-spacing-2); margin-bottom: var(--bh-spacing-10);">
        SkillSign serves both sides of the skill ecosystem.
      </p>
      <bh-grid gap="lg" min="320px">
        <bh-card variant="outlined" padding="lg">
          <div slot="header">
            <span class="heading-sm">✍️ Skill Authors</span>
          </div>
          <bh-stack gap="md">
            <p>Sign your skills with your GitHub identity to prove authorship and build trust.</p>
            <ul class="feature-list">
              <li>No key management — Sigstore handles ephemeral keys</li>
              <li>Works in CI via GitHub Actions OIDC</li>
              <li>Transparent audit trail on Rekor</li>
              <li>Detached signatures — SKILL.md stays clean</li>
            </ul>
          </bh-stack>
        </bh-card>

        <bh-card variant="outlined" padding="lg">
          <div slot="header">
            <span class="heading-sm">🔍 Skill Consumers</span>
          </div>
          <bh-stack gap="md">
            <p>Verify skills before you run them. Know who signed what and when.</p>
            <ul class="feature-list">
              <li>Verify signatures, certificates, and identity</li>
              <li>Policy engine for trust decisions</li>
              <li>Offline verification with bundled certificates</li>
              <li>Clear exit codes for CI integration</li>
            </ul>
          </bh-stack>
        </bh-card>
      </bh-grid>
    </div>
  </section>

  <!-- Install -->
  <section class="section section-alt">
    <div class="section-inner">
      <h2 class="heading-lg text-center">Install</h2>
      <p class="text-center text-muted" style="margin-top: var(--bh-spacing-2); margin-bottom: var(--bh-spacing-10);">
        Choose your preferred package manager.
      </p>
      <div class="install-tabs">
        <bh-tabs active="pip">
          <bh-tab-bar slot="tab-bar">
            <bh-tab tab-id="pip">pip</bh-tab>
            <bh-tab tab-id="uvx">uvx</bh-tab>
            <bh-tab tab-id="brew">brew</bh-tab>
          </bh-tab-bar>
          <bh-tab-panel tab-id="pip">
            <div class="code-block">pip install skillsign</div>
          </bh-tab-panel>
          <bh-tab-panel tab-id="uvx">
            <div class="code-block">uvx skillsign sign ./SKILL.md</div>
          </bh-tab-panel>
          <bh-tab-panel tab-id="brew">
            <div class="code-block">brew install bruk-io/tap/skillsign</div>
          </bh-tab-panel>
        </bh-tabs>
      </div>
      <div class="text-center" style="margin-top: var(--bh-spacing-8);">
        <bh-button variant="primary" size="lg" onclick={`window.location.href='${base}getting-started'`}>
          Quick Start Guide →
        </bh-button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding: var(--bh-spacing-24) var(--bh-spacing-6) var(--bh-spacing-20);
    text-align: center;
  }

  .hero-inner {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--bh-spacing-6);
  }

  .hero-subtitle {
    font-size: var(--bh-text-lg);
    max-width: 36rem;
    line-height: var(--bh-leading-relaxed);
  }

  .hero-install {
    margin-top: var(--bh-spacing-4);
  }

  .hero-install .code-block {
    display: inline-block;
    padding: var(--bh-spacing-2) var(--bh-spacing-6);
    font-size: var(--bh-text-sm);
  }

  /* Section inner */
  .section-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .section-alt {
    background: var(--bh-color-surface);
    padding: var(--bh-spacing-20) var(--bh-spacing-6);
  }

  .threat-icon {
    font-size: var(--bh-text-2xl);
    margin-right: var(--bh-spacing-3);
  }

  /* Steps */
  .steps-grid {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: var(--bh-spacing-4);
  }

  .step {
    flex: 1;
    max-width: 18rem;
    text-align: center;
  }

  .step-number {
    width: 3rem;
    height: 3rem;
    border-radius: var(--bh-radius-full);
    background: var(--bh-color-primary);
    color: var(--bh-color-primary-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--bh-font-bold);
    font-size: var(--bh-text-lg);
    margin: 0 auto var(--bh-spacing-4);
  }

  .step-arrow {
    color: var(--bh-color-text-muted);
    font-size: var(--bh-text-2xl);
    margin-top: var(--bh-spacing-3);
  }

  /* Personas */
  .feature-list {
    list-style: none;
    padding: 0;
  }

  .feature-list li {
    padding: var(--bh-spacing-1) 0;
    padding-left: var(--bh-spacing-6);
    position: relative;
    color: var(--bh-color-text-muted);
  }

  .feature-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--bh-color-success);
    font-weight: var(--bh-font-bold);
  }

  /* Install */
  .install-tabs {
    max-width: 36rem;
    margin: 0 auto;
  }

  .install-tabs .code-block {
    margin-top: var(--bh-spacing-4);
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--bh-spacing-16) var(--bh-spacing-4) var(--bh-spacing-12);
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .steps-grid {
      flex-direction: column;
      align-items: center;
    }
    .step-arrow {
      transform: rotate(90deg);
      margin: 0;
    }
  }
</style>
